{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "http://console.jhonaleystore.id:2895/"
    },
    {
      "source": "/s/:id",
      "destination": "http://console.jhonaleystore.id:2895/s/:id"
    },
    {
      "source": "/go/:id/:stage",
      "destination": "http://console.jhonaleystore.id:2895/go/:id/:stage"
    },
    {
      "source": "/api/:path*",
      "destination": "http://console.jhonaleystore.id:2895/api/:path*"
    },
    {
      "source": "/normal/:path*",
      "destination": "http://console.jhonaleystore.id:2895/normal/:path*"
    },
    {
      "source": "/vip/:path*",
      "destination": "http://console.jhonaleystore.id:2895/vip/:path*"
    },
    {
      "source": "/style.css",
      "destination": "http://console.jhonaleystore.id:2895/style.css"
    },
    {
      "source": "/app.js",
      "destination": "http://console.jhonaleystore.id:2895/app.js"
    },
    {
      "source": "/home.css",
      "destination": "http://console.jhonaleystore.id:2895/home.css"
    }
  ]
}
